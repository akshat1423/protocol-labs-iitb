# LLM API Keys (set at least one)
GEMINI_API_KEY=your_gemini_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# LLM Provider: "gemini" (default), "anthropic", or "openai"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# Blockchain
OPERATOR_PRIVATE_KEY=your_private_key_here
SEPOLIA_RPC_URL=https://rpc.sepolia.org
FILECOIN_CALIBRATION_RPC=https://api.calibration.node.glif.io/rpc/v1

# ERC-8004 Registry
ERC8004_REGISTRY_ADDRESS=0x...

# Lit Protocol
LIT_VINCENT_API_KEY=your_lit_key_here

# Storacha
STORACHA_SPACE_DID=your_space_did_here
STORACHA_AGENT_DID=your_agent_did_here

# Agent Config
AGENT_NAME=AgentProof-Alpha
COMPUTE_BUDGET_USD=5.00
MAX_LLM_CALLS=100
MAX_TOOL_CALLS=50
